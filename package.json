{
  "name": "ludo-premium-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "godot": "node scripts/godot.mjs run",
    "godot:editor": "node scripts/godot.mjs editor",
    "godot:templates:web": "node scripts/install-godot-web-templates.mjs",
    "godot:check": "node scripts/godot.mjs check",
    "godot:test": "node scripts/test-godot.mjs",
    "godot:test:leaving": "node scripts/test-godot.mjs leaving",
    "godot:test:captures": "node scripts/godot.mjs test:captures",
    "godot:test:computer": "node scripts/test-godot.mjs computer",
    "godot:test:computer:browser": "npm run godot:build:web && node scripts/test-godot-computer-browser.mjs",
    "godot:test:lives": "node scripts/test-godot.mjs lives",
    "godot:test:devices": "npm run godot:build:web && node scripts/test-godot-client-devices.mjs",
    "godot:test:keyboard": "npm run godot:build:web && node scripts/test-godot-keyboard.mjs",
    "godot:test:browser": "npm run godot:build:web && node scripts/test-godot-browser.mjs",
    "godot:build:web": "node scripts/godot.mjs build:web",
    "godot:preview:web": "node scripts/preview-godot.mjs",
    "godot:build:android": "node scripts/godot.mjs build:android",
    "dev": "vite",
    "web": "npm run godot:build:web && npm run godot:preview:web",
    "expo:web": "npm --prefix apps/mobile run web",
    "expo": "npm --prefix apps/mobile run start",
    "build": "tsc -b && vite build",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "npx serve apps/mobile/dist",
    "deploy:web": "npm run godot:build:web && npx firebase-tools deploy --only hosting --config firebase.godot.json",
    "server": "tsx watch apps/game-server/src/index.ts",
    "server:start": "tsx apps/game-server/src/index.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "vitest run",
    "export:e2e": "cd apps/mobile && EXPO_PUBLIC_REALTIME_URL=ws://127.0.0.1:19551 npx expo export --platform web --output-dir dist-e2e --clear",
    "test:browser": "npm run export:e2e && playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "ws": "latest",
    "@supabase/supabase-js": "latest",
    "dotenv": "latest",
    "@capacitor/core": "latest",
    "@capacitor/android": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vitest": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "tsx": "latest",
    "@capacitor/cli": "latest"
  }
}
