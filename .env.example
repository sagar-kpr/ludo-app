# Local development only. Copy to .env and supply your own values.
VITE_REALTIME_URL=ws://localhost:8787
EXPO_PUBLIC_REALTIME_URL=ws://192.168.1.10:8787

# Public frontend values. Never put a service-role secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only values. Optional for in-memory gameplay testing.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
